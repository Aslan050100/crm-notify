# Скопируйте этот файл в .env и впишите свои значения. Файл .env не попадает в git.

# Режим: test — только отчёт «кого бы поздравили», без отправки; live — реальная отправка
MODE=test

# ---- MyDent: amoCRM ----
# адрес аккаунта (из bo4smag.amocrm.ru)
MYDENT_AMO_SUBDOMAIN=bo4smag
# amoCRM → Настройки → Интеграции → ваша внешняя интеграция → «Ключи и доступы» → «Долгосрочный токен»
MYDENT_AMO_TOKEN=

# ---- MyDent: Wazzup ----
# Wazzup → Интеграции → API → ключ
MYDENT_WAZZUP_API_KEY=
# номер канала, с которого отправляем
MYDENT_WAZZUP_PHONE=77475307747
